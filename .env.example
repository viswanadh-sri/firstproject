mongodb_uri=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
APP_NAME=Secure FastAPI Auth
ENVIRONMENT=development
MONGODB_DATABASE=fastapi_auth
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_TIMEOUT_SECONDS=60
VIRUSTOTAL_RETRY_ATTEMPTS=3
VIRUSTOTAL_RETRY_BACKOFF_SECONDS=1
VIRUSTOTAL_POLL_INTERVAL_SECONDS=2
VIRUSTOTAL_MAX_POLL_SECONDS=180
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
